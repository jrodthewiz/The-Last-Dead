{
  "name": "the-last-dead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Last Dead: a movement-focused indie horror FPS with peer-to-peer co-op.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node server.mjs --dist .",
    "serve": "node server.mjs --dist .",
    "preview": "node server.mjs --dist dist",
    "start": "node server.mjs",
    "test": "node --test engine.test.mjs enemy-ai.test.mjs && node tests/network.test.mjs",
    "test:engine": "node --test engine.test.mjs",
    "test:blackwater": "node --test tests/blackwater-rewrite.test.mjs tests/blackwater-enhancement.test.mjs tests/blackwater-depth.test.mjs tests/blackwater-refuges.test.mjs tests/blackwater-scavenging.test.mjs tests/blackwater-movement.test.mjs tests/blackwater-navigation.test.mjs tests/blackwater-field-batches.test.mjs tests/blackwater-coop.test.mjs tests/blackwater-cohesion.test.mjs tests/blackwater-home-armory.test.mjs tests/blackwater-cottage-motion.test.mjs tests/blackwater-arsenal-progression.test.mjs tests/blackwater-salvage-models.test.mjs",
    "test:blackwater:browser": "node tests/blackwater-rewrite-browser.mjs",
    "test:blackwater:visual": "node tests/blackwater-visual-review.mjs",
    "test:bodycam": "node tests/bodycam-browser.mjs",
    "test:combat-motion": "node tests/combat-motion-browser.mjs",
    "test:network": "node tests/network.test.mjs",
    "test:coop": "node tests/melee-input-coop.mjs --coop-only --local-broker --skip-soak",
    "test:map": "node --test tests/map-playground.test.mjs",
    "test:story-art": "node --test tests/dungeon-art.test.mjs",
    "test:setdressing": "node --test tests/world-setdressing.test.mjs",
    "pretest:performance": "node build.mjs",
    "test:performance": "node tests/performance-matrix.mjs",
    "pretest:cut-preview": "node build.mjs",
    "test:cut-preview": "node tests/cut-preview-performance.mjs",
    "test:open-world": "node --test --test-isolation=none tests/dungeon-extension.test.mjs tests/scavenger-pack.test.mjs tests/weapon-fitting-integration.test.mjs tests/scavenger-iteration.test.mjs",
    "test:open-world:browser": "node tests/open-world-poc-browser.mjs",
    "test:harbor": "node --test --test-isolation=none tests/harbor-course.test.mjs tests/harbor-navigation.test.mjs tests/harbor-vehicle.test.mjs tests/weapon-inventory.test.mjs",
    "test:harbor:browser": "node tests/harbor-browser.mjs",
    "test:blackwater:enhancement": "node tests/blackwater-enhancement-browser.mjs",
    "test:blackwater:depth": "node tests/blackwater-depth-browser.mjs",
    "test:blackwater:shotgun": "node tests/blackwater-shotgun-review.mjs",
    "test:blackwater:combat": "node tests/blackwater-combat-review.mjs",
    "test:blackwater:atmosphere": "node tests/blackwater-atmosphere-review.mjs",
    "test:blackwater:character": "node tests/blackwater-character-review.mjs",
    "test:blackwater:settlement": "node tests/blackwater-settlement-review.mjs",
    "test:blackwater:ui": "node tests/blackwater-ui-review.mjs",
    "test:blackwater:craft": "node tests/blackwater-coast-craft-review.mjs",
    "test:blackwater:scavenging": "node tests/blackwater-scavenging-browser.mjs",
    "test:blackwater:scavenging-combat": "node tests/blackwater-scavenging-combat.mjs",
    "test:blackwater:refuges": "node tests/blackwater-refuges-review.mjs",
    "test:blackwater:movement": "node tests/blackwater-mobility-browser.mjs",
    "test:blackwater:fluidity": "node tests/blackwater-fluidity-browser.mjs",
    "test:blackwater:profile": "node tests/blackwater-motion-performance.mjs",
    "test:blackwater:soak": "node tests/blackwater-traversal-soak.mjs",
    "test:blackwater:recovery": "node tests/blackwater-first-person-recovery.mjs",
    "test:blackwater:coop": "node tests/blackwater-coop-browser.mjs",
    "build:site": "node scripts/prepare-blackwater-site.mjs",
    "test:blackwater:cohesion": "node tests/blackwater-cohesion-review.mjs",
    "test:blackwater:handling": "node tests/blackwater-home-armory-review.mjs",
    "test:blackwater:input": "node scripts/verify-gameplay-input.mjs && node scripts/verify-first-person.mjs",
    "test:blackwater:cottage-motion": "node tests/blackwater-cottage-motion-review.mjs",
    "test:blackwater:arsenal": "node tests/blackwater-arsenal-vision.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "three": "0.184.0",
    "vgpu": "0.5.0"
  }
}
