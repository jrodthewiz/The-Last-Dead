{
  "name": "the-last-dead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Last Dead: a movement-focused indie horror FPS with peer-to-peer co-op.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node server.mjs --dist .",
    "serve": "node server.mjs --dist .",
    "preview": "node server.mjs --dist dist",
    "start": "node server.mjs",
    "test": "node --test engine.test.mjs enemy-ai.test.mjs && node tests/network.test.mjs",
    "test:engine": "node --test engine.test.mjs",
    "test:bodycam": "node tests/bodycam-browser.mjs",
    "test:combat-motion": "node tests/combat-motion-browser.mjs",
    "test:network": "node tests/network.test.mjs",
    "test:coop": "node tests/coop-game.test.mjs",
    "test:map": "node --test tests/map-playground.test.mjs",
    "test:story-art": "node --test tests/dungeon-art.test.mjs",
    "test:setdressing": "node --test tests/world-setdressing.test.mjs",
    "pretest:performance": "node build.mjs",
    "test:performance": "node tests/performance-matrix.mjs",
    "pretest:cut-preview": "node build.mjs",
    "test:cut-preview": "node tests/cut-preview-performance.mjs",
    "test:open-world": "node --test --test-isolation=none tests/dungeon-extension.test.mjs tests/scavenger-pack.test.mjs tests/weapon-fitting-integration.test.mjs tests/scavenger-iteration.test.mjs",
    "test:open-world:browser": "node tests/open-world-poc-browser.mjs",
    "test:harbor": "node --test --test-isolation=none tests/harbor-course.test.mjs tests/harbor-navigation.test.mjs tests/harbor-vehicle.test.mjs tests/weapon-inventory.test.mjs",
    "test:harbor:browser": "node tests/harbor-browser.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "three": "0.184.0",
    "vgpu": "0.5.0"
  }
}
